# Pooled Neon PostgreSQL URL for application queries
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require

# Direct Neon PostgreSQL URL for manual migrations and seed scripts
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# Generate a random value with: openssl rand -base64 32
JWT_SECRET=replace-me

# Used only by: npm run db:seed:admin
ADMIN_SEED_EMAIL=replace-me
ADMIN_SEED_PASSWORD=replace-me

# Used only by: npm run db:seed:dashboard. Point to a direct development branch.
DASHBOARD_SEED_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_DEVELOPMENT_HOST/DATABASE?sslmode=require
DASHBOARD_SEED_CUSTOMER_EMAIL=customer@example.com
DASHBOARD_SEED_CONFIRM=development

# Optional simulated dashboard feed: success (default), slow, error, timeout
MARKET_FEED_MODE=success
